# ===========================================================================
# TEOS TRADE AGENT - ENVIRONMENT TEMPLATE
# ===========================================================================
# Copy to `.env` for local use. `.env` is git-ignored and MUST NEVER be
# committed, packaged, or sent to the dashboard/browser.
#
# PHASE 1 RULE: there are NO credentials. Every credential entry below is
# intentionally EMPTY and the live-trading loader refuses to start if any of
# them is populated. They exist so the read-only market-data credentials and
# the (disabled) trading credentials stay in separate namespaces.
# ===========================================================================

# --- Runtime mode -----------------------------------------------------------
# BACKTEST | PAPER.  LIVE is not implemented and is hard-blocked in code.
TEOS_MODE=PAPER

# --- Local file locations ---------------------------------------------------
TEOS_DATA_DIR=./data
TEOS_LOG_DIR=./logs
TEOS_CONFIG=./config/default.json

# --- Dashboard --------------------------------------------------------------
# Bound to loopback by default. There is no frontend credential here by design.
TEOS_DASHBOARD_HOST=127.0.0.1
TEOS_DASHBOARD_PORT=8787
# Optional shared secret required only if the dashboard is bound off-loopback.
# If unset and the host is not loopback, the server refuses to start.
TEOS_DASHBOARD_TOKEN=

# --- Logging ----------------------------------------------------------------
TEOS_LOG_LEVEL=info

# --- READ-ONLY MARKET DATA CREDENTIALS (separate namespace) -----------------
# Phase 1: the market data source is a local deterministic simulator.
# These MUST stay empty. The loader treats any value here as a configuration
# error, because an unused credential is a latent leak.
TEOS_MARKET_DATA_API_KEY=
TEOS_MARKET_DATA_API_SECRET=

# --- TRADING CREDENTIALS (separate namespace, DISABLED IN PHASE 1) ---------
# Phase 1: no order ever leaves the process. The trading credentials module
# is physically implemented as a throwing stub.
TEOS_TRADING_API_KEY=
TEOS_TRADING_API_SECRET=
TEOS_TRADING_API_PASSPHRASE=
TEOS_LIVE_TRADING_ENABLED=false
